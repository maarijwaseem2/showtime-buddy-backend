# IMPORTANT: Local .env is NOT deployed to Render. Paste each variable in:
# Render Dashboard → your Web Service → Environment → Add Environment Variable

PORT=3000
NODE_ENV=production
API_URL=https://YOUR-SERVICE.onrender.com

# Required — your Neon URL (delete DATABASE_HOST if you added it from .env.example)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_SYNC=false
DATABASE_RUN_MIGRATIONS=true
JWT_SECRET=your-long-random-secret
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@cineslot.com
ADMIN_PASSWORD=change-me
UPLOAD_DIR=uploads
CORS_ORIGINS=https://maarijwaseem2-showtime-buddy.vercel.app

# Render settings:
# Build Command:  npm install; npm run build
# Start Command:  npm run start
