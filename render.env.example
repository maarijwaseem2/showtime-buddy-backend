# Paste into Render → Environment (one KEY=VALUE per line in the dashboard UI)

PORT=3000
NODE_ENV=production
API_URL=https://YOUR-SERVICE.onrender.com
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_SYNC=false
DATABASE_RUN_MIGRATIONS=true
JWT_SECRET=your-long-random-secret
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@cineslot.com
ADMIN_PASSWORD=change-me
UPLOAD_DIR=uploads
CORS_ORIGINS=https://showtime-buddy.vercel.app,https://www.showtime-buddy.vercel.app

# Render settings:
# Build Command:  npm install; npm run build
# Start Command:  npm run start
