# Render (Web Service → Environment) — copy each line, replace placeholders

PORT=3000
NODE_ENV=production
API_URL=https://YOUR-SERVICE.onrender.com

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

DATABASE_SYNC=false
DATABASE_RUN_MIGRATIONS=true

JWT_SECRET=generate-a-long-random-string
JWT_EXPIRES_IN=7d

ADMIN_EMAIL=admin@cineslot.com
ADMIN_PASSWORD=change-after-first-login

UPLOAD_DIR=uploads

CORS_ORIGINS=https://showtime-buddy.vercel.app,https://www.showtime-buddy.vercel.app
