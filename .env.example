# Server
PORT=3000
NODE_ENV=development
API_URL=http://localhost:3000

# PostgreSQL (use either DATABASE_URL or the variables below)
# Render: link your Postgres service — it injects DATABASE_URL automatically
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password
DATABASE_NAME=cineslot
# Set true if your provider requires SSL (Render external URLs often include ?sslmode=require)
DATABASE_SSL=false

# TypeORM (set true only for local quick dev; use migrations in production)
DATABASE_SYNC=false
DATABASE_RUN_MIGRATIONS=false

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d

# Admin seed (created on first seed run)
ADMIN_EMAIL=admin@cineslot.com
ADMIN_PASSWORD=admin123

# Uploads
UPLOAD_DIR=uploads

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# --- Production (see .env.production.example / render.env.example) ---
# API_URL=https://YOUR-SERVICE.onrender.com
# DATABASE_URL=postgresql://...@neon.tech/showtime?sslmode=require
# CORS_ORIGINS=https://showtime-buddy.vercel.app
